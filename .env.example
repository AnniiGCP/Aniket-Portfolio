# GitHub Personal Access Token (for fetching live GitHub contribution activity)
# Generate at: https://github.com/settings/tokens (public_repo / read:user scope)
GITHUB_TOKEN=your_github_personal_access_token_here

# Canonical Site URL (used for sitemap.xml, robots.txt, OpenGraph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://aniketyadav.tech

# Google Analytics 4 Measurement ID (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
